import pandas as pd
from datetime import datetime
import os

def convert_csv_format(input_file, output_file):
    # Check if the input file exists
    if not os.path.isfile(input_file):
        print("The provided input file path does not exist.")
        return
    
    # Function to convert date to Unix time
    def to_unix_time(date_str):
        dt = datetime.strptime(date_str, "%Y-%m-%d")
        return int(dt.timestamp())

    # Function to convert date to the desired format
    def to_formatted_date(date_str):
        dt = datetime.strptime(date_str, "%Y-%m-%d")
        return dt.strftime("%Y-%m-%d 00:00:00")
    
    # Read the original CSV file
    df = pd.read_csv(input_file)
    
    # Create a new DataFrame with the desired format
    new_data = {
        "unix": [to_unix_time(date) for date in df["Start"]],
        "date": [to_formatted_date(date) for date in df["Start"]],
        "symbol": ["BTC/EUR"] * len(df),
        "open": df["Open"],
        "high": df["High"],
        "low": df["Low"],
        "close": df["Close"],
        "volume": df["Volume"],
        "total": df["Market Cap"]
    }
    
    new_df = pd.DataFrame(new_data)
    
    # Add the extra information at the beginning of the new DataFrame
    header_info = pd.DataFrame([["https://www.Saxcoin-b6.nl", "BTC", "Bitcoin"]], columns=new_df.columns[:3])
    new_df = pd.concat([header_info, new_df])
    
    # Save the new CSV file
    new_df.to_csv(output_file, index=False)
    
    print(f"The new CSV file has been saved as '{output_file}'.")

# Print instructions
print("This script will convert the format of the specified CSV file to the desired format.")

# Prompt the user to enter the input and output file paths
input_file = input("Please enter the path to the input CSV file: ")
output_file = input("Please enter the path to the output CSV file: ")

# Call the function to convert the CSV format
convert_csv_format(input_file, output_file)
