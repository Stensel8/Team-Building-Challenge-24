#!/bin/bash

# Define variables
SSH_KEY_NAME="id_ed25519"
SSH_KEY_TYPE="ed25519"
REMOTE_USER="yustin"
REMOTE_SERVERS=("192.168.20.125")  # Add more servers as needed
GITLAB_REPO="git@gitlab.com:saxion.nl/hbo-ict/1.4-project-team-building-challenge-infra/opdracht/ehi1v.ib/24.git"

# Maak SSH-key aan
ssh-keygen -t $SSH_KEY_TYPE

# Function to setup SSH keys on the remote server
setup_ssh_key_on_server() {
  local server=$1

  echo "Setting up SSH key on server: $server"

  #Copy SSH public key to the remote server
  ssh-copy-id -i ~/.ssh/$SSH_KEY_NAME.pub $REMOTE_USER@$server

  # Copy SSH key to the remote server
  scp ~/.ssh/$SSH_KEY_NAME $REMOTE_USER@$server:~/.ssh/$SSH_KEY_NAME
  scp ~/.ssh/$SSH_KEY_NAME.pub $REMOTE_USER@$server:~/.ssh/$SSH_KEY_NAME.pub

  # Log in to the remote server and configure the SSH key
  ssh $REMOTE_USER@$server << EOF
    chmod 600 ~/.ssh/$SSH_KEY_NAME
    chmod 644 ~/.ssh/$SSH_KEY_NAME.pub
    ssh-keyscan gitlab.com >> ~/.ssh/known_hosts
    eval "\$(ssh-agent -s)"
    ssh-add ~/.ssh/$SSH_KEY_NAME
    # Test the SSH connection to GitLab
    ssh -T git@gitlab.com
EOF
}

# Loop through all remote servers and set up SSH keys
for server in "${REMOTE_SERVERS[@]}"; do
  setup_ssh_key_on_server $server
done

echo "SSH key setup completed on all servers."

cat ~/.ssh/id_ed25519.pub